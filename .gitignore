# Ignore everything
*

# Allow directories
!*/

# Ignore dirs of old books
.git/
Linux-System-Programming-Book/
My-Codes/
Virtual-Memory/
Assembly/
Network/

# Allow source code, headers, assembly and scripts
!*.c
!*.o
!*.h
!*.s
!*.S
!*.asm
!*.py
!*.sh
!Makefile
!makefile

# Allow documentation and git config files
!*.md
!*.txt
!.gitignore
!.gitattributes
